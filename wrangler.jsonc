// ケア72 の Workers の設定。
// 配信は作者が手で打つ（docs/tasks/T27.md）。D1 care72 と R2 care72-recordings は 11/2 に作った本物。
// account_id は書かない（作者の wrangler のログインから決まる）。手元の dev と --local はこの設定のまま動く。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "care72",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "care72",
      "database_id": "90da0202-9eae-42e1-9fd4-065c33224a8d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECORDINGS",
      "bucket_name": "care72-recordings"
    }
  ]
}
