// ケア72 の Workers の設定。
// 配信は作者が手で打つ（docs/tasks/T27.md）。D1 care72 と R2 care72-recordings は配信先の本物。
// account_id は書かない（作者の wrangler のログインから決まる）。手元の dev と --local はこの設定のまま動く。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "care72",
  "routes": [{ "pattern": "care72.app", "custom_domain": true }],
  // 入口は worker.ts（.open-next/worker.js の fetch に、毎日 4 時にデモ事業所を種に戻す scheduled を足した物。docs/tasks/T26.md）
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "care72",
      "database_id": "90da0202-9eae-42e1-9fd4-065c33224a8d",
      "migrations_dir": "migrations"
    }
  ],
  // 毎日 19:00 UTC（4:00 JST）にデモ事業所を種に戻す（lib/seed/cron.ts の DAILY_RESET_CRON と同じ文字）。
  // 5 分ごとに気象庁の防災情報 XML を取って D1 に写す（lib/jma/cron.ts の JMA_FETCH_CRON と同じ文字。T72）
  "triggers": { "crons": ["0 19 * * *", "*/5 * * * *"] },
  // AI の 1 日の上限（デモ事業所だけに効く。lib/claude/usage.ts の dailyLimit）。既定は 200、デモ事業所は 600（docs/DECISIONS.md「配信と守り」）
  "vars": { "AI_DAILY_LIMIT": "600" },
  "r2_buckets": [
    {
      "binding": "RECORDINGS",
      "bucket_name": "care72-recordings"
    }
  ]
}
