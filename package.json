{
  "name": "care72",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "postinstall": "node tools/deploy/write-version.ts",
    "predev": "node tools/deploy/write-version.ts",
    "dev": "next dev -p 3072",
    "prebuild": "node tools/deploy/write-version.ts",
    "build": "next build",
    "start": "next start -p 3072",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "pretypecheck": "node tools/deploy/write-version.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "node seed/build-sql.ts && wrangler d1 execute DB --local --file=seed/generated/seed.sql && node seed/put-recording.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "db:fresh": "node seed/wipe-local.ts && npm run db:reset",
    "jma:fetch-local": "node tools/jma/local.ts",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:remote": "node seed/build-sql.ts && wrangler d1 execute DB --remote --file=seed/generated/seed.sql",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "docs:triage": "node lib/triage/build-doc.ts",
    "docs:notices": "node tools/licenses/notices.mjs",
    "eval:forms": "node tools/eval/forms/cli.ts",
    "hash-password": "node tools/hash-password.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:drill": "node tools/eval/drill/run.ts",
    "eval:talk": "node tools/eval/talk/run.ts",
    "eval:scorecard": "node tools/eval/scorecard.ts",
    "eval:drafts": "node tools/eval/drafts.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@google/genai": "2.32.0",
    "@heroicons/react": "2.2.0",
    "@opennextjs/cloudflare": "1.20.15",
    "fast-xml-parser": "5.11.2",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "puppeteer-core": "25.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.156.1"
  },
  "overrides": {
    "is-unsafe": "2.0.2"
  }
}
