{
  "name": "care72",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3072",
    "build": "next build",
    "start": "next start -p 3072",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "node seed/build-sql.ts && wrangler d1 execute DB --local --file=seed/generated/seed.sql",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "db:fresh": "node seed/wipe-local.ts && npm run db:reset",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:remote": "node seed/build-sql.ts && wrangler d1 execute DB --remote --file=seed/generated/seed.sql",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "docs:triage": "node lib/triage/build-doc.ts",
    "hash-password": "node tools/hash-password.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@google/genai": "2.32.0",
    "@opennextjs/cloudflare": "1.20.15",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.156.1"
  }
}
